# Variables for local development environment

# Application settings
NESTJS_APPLICATION_ENV=local
NESTJS_APPLICATION_PORT=3000
NESTJS_APPLICATION_VERSION=1.0.0

# Client settings 
NESTJS_CLIENT_URL=http://localhost:8080

# Swagger settings
NESTJS_SWAGGER_ENABLED=true

# Twitch settings
NESTJS_TWITCH_REDIRECT_URI=http://localhost:3000/api/v1/twitch/auth/callback

# Youtube settings
NESTJS_YOUTUBE_REDIRECT_URI=http://localhost:3000/api/v1/youtube/auth/callback
